{
	"name": "kvex",
	"private": true,
	"version": "0.0.0",
	"packageManager": "pnpm@11.7.0",
	"type": "module",
	"scripts": {
		"start": "pnpm dev:all",
		"dev": "vite --host 0.0.0.0",
		"dev:all": "node ./scripts/dev-all.mjs",
		"dev:reset": "node ./scripts/dev-all.mjs --reset",
		"dev:bff": "pnpm --dir server dev",
		"docker:up": "docker compose up -d",
		"docker:down": "docker compose down",
		"build": "vue-tsc -b && vite build",
		"build:bff": "pnpm --dir server build",
		"lint": "oxlint src server/src",
		"lint:fix": "oxlint --fix src server/src",
		"preview": "vite preview",
		"start:bff": "pnpm --dir server start",
		"test:frontend": "vitest run --config vitest.config.ts"
	},
	"dependencies": {
		"@primeuix/themes": "^2.0.2",
		"@tanstack/vue-query": "^5.92.1",
		"@vuelidate/core": "^2.0.3",
		"@vuelidate/validators": "^2.0.4",
		"@vueuse/core": "^14.1.0",
		"primeicons": "^7.0.0",
		"primevue": "^4.5.4",
		"socket.io-client": "^4.8.3",
		"vue": "^3.5.24",
		"vue-router": "^4.6.4"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24.10.1",
		"@vitejs/plugin-vue": "^6.0.1",
		"@vue/tsconfig": "^0.8.1",
		"oxlint": "^1.60.0",
		"tailwindcss": "^4.3.0",
		"typescript": "~5.9.3",
		"vite": "npm:rolldown-vite@7.2.5",
		"vite-plugin-vue-devtools": "^8.0.5",
		"vitest": "^4.1.4",
		"vue-tsc": "^3.1.4"
	}
}
