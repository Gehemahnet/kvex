{
	"name": "dex-bff-server",
	"version": "1.0.0",
	"packageManager": "pnpm@10.18.3",
	"type": "module",
	"imports": {
		"#common/*": "./src/common/*.ts",
		"#exchanges/*": "./src/exchanges/*.ts",
		"#server/*": "./src/server/*.ts",
		"#services/*": "./src/services/*.ts",
		"#storage/*": "./src/storage/*.ts"
	},
	"scripts": {
		"dev": "tsx watch --clear-screen=false ./src/server/index.ts",
		"dev:once": "tsx ./src/server/index.ts",
		"build": "tsup src/server/index.ts --format esm --dts",
		"migrate": "tsx ./src/storage/postgres/run-migrations.ts",
		"start": "node dist/index.js",
		"test": "vitest",
		"lint": "oxlint src",
		"lint:fix": "oxlint --fix src"
	},
	"dependencies": {
		"@covalenthq/client-sdk": "^3.0.6",
		"@nadohq/client": "^0.21.2",
		"bignumber.js": "^11.1.3",
		"dotenv": "^17.4.1",
		"pg": "^8.20.0",
		"redis": "^6.0.0",
		"socket.io": "^4.8.3",
		"viem": "^2.52.2",
		"ws": "^8.18.0"
	},
	"devDependencies": {
		"@types/node": "^24.10.1",
		"@types/pg": "^8.20.0",
		"@types/ws": "^8.18.1",
		"oxlint": "^1.60.0",
		"tsup": "^8.5.1",
		"tsx": "^4.20.0",
		"typescript": "~5.9.3",
		"vitest": "^4.1.2"
	}
}
